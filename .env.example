# All secrets must be configured on the deployment server, never commit .env.
# Local Docker demo uses persistent SQLite volume. For production use a dedicated PostgreSQL database.
DATABASE_URL=postgresql+psycopg://postgres:password@db.example.net:5432/postgres
# Vercel requires persistent Postgres plus this secret:
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_CHAT_ID=
WORKER_SECRET=

# Select any of 9 supported providers; Gemini default, no automatic paid fallback.
AI_PROVIDER=gemini
# Optional separate providers for creating drafts and applying Telegram revisions.
AI_DRAFT_PROVIDER=
AI_REWRITE_PROVIDER=
AI_DRAFT_MODEL=
AI_REWRITE_MODEL=
# Failover is OFF. If enabled, paid fallback requires explicit second opt-in.
AI_ENABLE_FALLBACK=false
AI_FALLBACK_PROVIDERS=
AI_ALLOW_PAID_FALLBACK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Ollama must run on this same host. It is not auto-installed.
OLLAMA_MODEL=qwen2.5:7b

INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
INSTAGRAM_GRAPH_VERSION=v24.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=unfounded-media
MEDIA_DIR=./media
BRAND_LOGO_PATH=
BRAND_FONT_PATH=
ENABLE_LIVE_PUBLISH=false
DAILY_PUBLISH_LIMIT=2
