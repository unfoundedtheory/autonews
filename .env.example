# All secrets must be configured on the deployment server, never commit .env.
# Local Docker demo uses persistent SQLite volume. For production use a dedicated PostgreSQL database.
# Docker demo SQLite persists in the ut_state named volume. For local non-Docker
# Python, override with DATABASE_URL=sqlite:///./ut_local.db.
# Production Vercel MUST replace this with a real persistent PostgreSQL URL.
DATABASE_URL=sqlite:////app/state/ut_local.db
# Example production value (do not use this dummy hostname):
# DATABASE_URL=postgresql+psycopg://postgres:password@db.example.net:5432/postgres
# Vercel requires persistent Postgres plus this secret:
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_CHAT_ID=
WORKER_SECRET=

# Select any of 9 supported providers; Gemini default, no automatic paid fallback.
AI_PROVIDER=gemini
# Optional separate providers for creating drafts and applying Telegram revisions.
AI_DRAFT_PROVIDER=
AI_REWRITE_PROVIDER=
AI_DRAFT_MODEL=
AI_REWRITE_MODEL=
# Failover is OFF. If enabled, paid fallback requires explicit second opt-in.
AI_ENABLE_FALLBACK=false
AI_FALLBACK_PROVIDERS=
AI_ALLOW_PAID_FALLBACK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Ollama must run on this same host. It is not auto-installed.
OLLAMA_MODEL=qwen2.5:7b

INSTAGRAM_GRAPH_VERSION=v24.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Meta OAuth (only set through your deployment secrets manager).
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_CONNECT_PASSWORD=
META_TOKEN_ENCRYPTION_KEY=
# Must match the actual public HTTPS deployment domain for redirect_uri.
META_OAUTH_BASE_URL=https://autonews-sage.vercel.app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=unfounded-media
# Vercel always uses /tmp/unfounded-media; set MEDIA_DIR only for local / Docker.
MEDIA_DIR=./media
BRAND_LOGO_PATH=
BRAND_FONT_PATH=
ENABLE_LIVE_PUBLISH=false
DAILY_PUBLISH_LIMIT=3

# PHOTO MUSIC: native Instagram songs cannot be injected into Graph API photo posts.
# manual = Telegram 4:5 photo+caption handoff; editor adds music and publishes
# in Instagram app, then replies with the final https://instagram.com/p/... URL.
# off = API photo-only publishing (NO music); requires ENABLE_LIVE_PUBLISH=true.
PHOTO_MUSIC_MODE=manual

# Optional independent Facebook Page post after editor confirms Instagram.
# KEEP FALSE if Instagram's native "Share to Facebook" is already enabled.
# Prevent double Facebook posts: use one publishing route only.
FACEBOOK_CROSSPOST=false
FACEBOOK_GRAPH_VERSION=v24.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# For Instagram API with Facebook Login, use graph.facebook.com.
INSTAGRAM_GRAPH_BASE=https://graph.facebook.com

# Editorial stock, music-in-Instagram Drafts and guarded timeout fallback
DRAFT_STOCK_TARGET=14
PREPARE_BATCH_LIMIT=3
AUTO_APPROVE_AFTER_24H=false
# Keep ENABLE_LIVE_PUBLISH=false until official Meta API connection, rights,
# official logo, and a one-post production publishing test are verified.
# Approved music drafts never switch automatically to silent publication.
