{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/discover",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/prepare",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/prepare/afternoon",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/prepare/morning",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/prepare/evening",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/tick/morning",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/tick/noon",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/tick/evening",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/tick/night",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 21 * * *"
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "docs/editorial-guide.md"
    }
  }
}
